procedure TLosPagosExcel.INSERTARClick(Sender: TObject);
var gf,a,reg:integer;
    txtw:string;
var Cnx2:TADOConnection;
begin
  gf:=messagedlg('Confirma GUARDAR los datos del PosnetPagoRecibo?',mtWarning,[mbok,mbCancel],0);
  if gf = 1 then begin
   try
    Cnx2:=TADOConnection.Create(nil);
    Cnx2.LoginPrompt:=false;
    Cnx2.ConnectionString:=modulo2.ConectDbMuni;
    DataSet4:=TADODataSet.Create(nil);
    DataSet4.Connection:=Cnx2;
    Com1:=TADOCommand.Create(nil);
    Com1.Connection:=Cnx2;

    /// 1er paso eliminamos los datos de la tabla origen
    Com1.CommandText:='truncate table [dbo].[MaratonPagos]';
    Com1.Execute;

    /// 2do paso insertamos los datos de la tabla origen
    for gf:=1 to StringGrid1.RowCount-1 do begin
     Com1.CommandText:='INSERT INTO [dbo].[MaratonPagos] ([nroorden],[rubro],[pv],[liquidacion]'
     +',[importe],[pvrecibo],[recibo],[observ]) VALUES  (' +  chr(39) + trim(StringGrid1.Cells[0,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[1,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[2,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[3,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[4,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[5,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[6,gf]) + chr(39)
     + ' , ' + chr(39) + trim(StringGrid1.Cells[7,gf]) + chr(39)
     + ')';
     Com1.Execute;
    end;

    DataSet4.CommandText:='SELECT count(*) as cantidad FROM [dbo].[MaratonPagos]';
    DataSet4.Open;
    if not DataSet4.isempty then begin
     reg:=strtoint(trim(DataSet4.Fields[0].AsString));
    end;
    DataSet4.Close;
    DataSet4.Connection:=nil;

    if totalRegistros = reg  then begin
      // ahora corremos el sp de insercion de los registros a RECIBOS
      Com1.CommandText:='PRC_InsertaPagosExternosaRecibos_Insertar ' + chr(39) + trim(DateToStr(ld.Date)) + chr(39);
      Com1.Execute;

      ok.Visible:=true;
      no.Visible:=false;
      label7.Visible :=true;
      label7.Caption:='Los Pagos fueron Guardados correctamente..';
      Limpiar(1);
      pc1.Pages[0].TabVisible:=true;
      PC1.ActivePage:=PC1.Pages[0];
      // consulto por las diferencias
      Consultas(2);
      PC2.ActivePage:=PC2.Pages[1];
    end
    else begin
     //Consultas(2);
     //PC2.ActivePage:=PC2.Pages[1];
     ok.Visible:=false;
     no.Visible:=true;
     label7.Visible :=true;
     label7.Caption:='ERROR NO se guardo el total de registros';
    end;
   except
    EnviarLog(self.Caption,Com1.CommandText);
    ok.Visible:=false;
    no.Visible:=true;
    label7.Caption:='ERROR al Guardar los Datos.. ';
   end;
   FreeAndNil(Com1);
   Cnx2.Close;
   FreeAndNil(Cnx2);
  end;
end;

procedure TLosPagosExcel.btnImportarClick(Sender: TObject);
var origen:string;
    i,fila:integer;
    RutaCarpeta,RutaArchivo: string;

begin
 origen:='C:\PagosExcel\Maraton2026final.xls';
 RutaCarpeta := 'C:\PagosExcel';
 RutaArchivo := trim(origen);
 if DirectoryExists(RutaCarpeta) then   begin
   if FileExists(RutaArchivo) then begin
     if OpenDialog1.Execute then begin
      // La propiedad FileName contiene la ruta completa del archivo seleccionado
      //ShowMessage('El archivo seleccionado es: ' + OpenDialog1.FileName);
      folder.text:=  OpenDialog1.FileName;
      if trim(folder.Text) = trim(origen) then begin

       FDConnection1.Connected := True;

       FDQuery1.Connection := FDConnection1;
       FDQuery1.SQL.Text := 'SELECT * FROM [Maraton2026$]';
       FDQuery1.Open;

       // 1. Configuramos las columnas basadas en los campos del Excel
       StringGrid1.ColCount := FDQuery1.FieldCount;

       // 2. Empezamos con 1 fila (la de la cabecera)
       StringGrid1.RowCount := 1;

       // 3. Cargamos las cabeceras
       for i := 0 to FDQuery1.FieldCount - 1 do
       StringGrid1.Cells[i, 0] := FDQuery1.Fields[i].FieldName;

        // 4. Recorremos los registros aumentando el RowGrid dinámicamente
       Fila := 1;
       FDQuery1.First;
       while not FDQuery1.Eof do begin
        // Creamos una nueva fila en el StringGrid antes de rellenarla
         StringGrid1.RowCount := Fila + 1;

         for i := 0 to FDQuery1.FieldCount - 1 do
          StringGrid1.Cells[i, Fila] := FDQuery1.Fields[i].AsString;

         Inc(Fila);
         FDQuery1.Next;
       end;

       FDQuery1.Close;

       ok.Visible:=true;
       no.Visible:=false;
       totalRegistros := StringGrid1.RowCount - 1 ;//StringGrid1.FixedRows;
       edit1.Text := inttostr(totalRegistros);
       label7.Caption:='Archivo Cargado con Exito';
       insertar.Visible :=true;
       insertar.Enabled :=true;
      end
      else begin
       ok.Visible:=false;
       no.Visible:=true;
       label7.Caption:='Error en Archivo de Origen.';
       insertar.Visible :=false;
       insertar.Enabled :=false;
      end;
     end;
   end
   else begin
    ShowMessage('El archivo ''Maraton2026final.xls''  NO existe.');
    ld.SetFocus ;
   end;
 end
 else begin
    ShowMessage('La carpeta ''C:\PagosExcel'' NO existe.');
    ld.SetFocus ;
 end;
end;

