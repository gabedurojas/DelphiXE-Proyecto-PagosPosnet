   + ' FROM ComerciosTH INNER JOIN ComerciosTHDetalle ON ComerciosTHDetalle.IdTH = ComerciosTH.Id WHERE '
   + '(ComerciosTHDetalle.Activo=1) and (IdComercio=' + COMERCIOS.Fields[0].AsString + ')';
   CANTCOM.Open;
   if ACTIV.IsEmpty then begin
    CANTCOM.Close;
   end
   else begin
    //CANTCOM.Close;
   end;
  end
  else begin
   ACTIV.Close
  end;
  CANTCOM.Connection :=nil;
 end;
 if nro = 4 then begin
  ConPlan:=false;
  DataSetPagos.ConnectionString:=modulo2.ConecMuni;
  if not ACTIV.IsEmpty then begin
   ESTCUE.Close;
   ESTCUE.Connection:=modulo2.ObjConexionMuni;
   DTS6.DataSet:=ESTCUE;
   ESTCUE.CommandText:='SELECT idcomercio,th,impuesto,subrubro,nrocuota,anio,periodo,'
   +'fechavencimiento,importecuota,InteresAcumulado,porcentajeaplicado,estadovto,'
   +'estadopago,origenpago,IdEximision ,nrorecibo,PorcentajeEximido ,ImporteEximido,idth'
   +' FROM EstadoCuentaComercioTasaIdCnExim (' + COMERCIOS.Fields[0].AsString +  ',' + chr(39) + FechaActual + chr(39) + ',5)';
   ESTCUE.Open;
   {DataSetPlanes.ConnectionString:=modulo2.ConecMuni;
   DataSetPlanes.CommandText:='SELECT distinct nroplan,identificador,codigoobjeto,estadoplan,cantidadcuotasimpagas,totaldeudaplan'
   + ' FROM ObjetosEnPlanesdePago (' + COMERCIOS.Fields[11].AsString+ ' , 1111801) '
   + ' where totaldeudaplan > 0 and (EstadoPlan = ''VIGENTE'' or EstadoPlan =''CAIDO'') and identificador is not null';
   DataSetPlanes.Open;
   if not DataSetPlanes.IsEmpty  then begin
    ConPlan:=true;
    for t:=1 to DataSetPlanes.RecordCount do begin
     DataSetPlanes.RecNo:=t;
     grillasplanes.RowCount:=t+1;
     grillasplanes.Cells[0,t]:=trim(DataSetPlanes.Fields[0].AsString);
     grillasplanes.Cells[1,t]:=trim(DataSetPlanes.Fields[1].AsString);
     grillasplanes.Cells[2,t]:=trim(DataSetPlanes.Fields[2].AsString);
     grillasplanes.Cells[3,t]:=trim(DataSetPlanes.Fields[3].AsString);
     grillasplanes.Cells[4,t]:=trim(DataSetPlanes.Fields[4].AsString);
     grillasplanes.Cells[5,t]:=trim(DataSetPlanes.Fields[5].AsString);
     totalplanpago := totalplanpago + strtofloat(grillasplanes.Cells[5,t]);
    end;
   end
   else begin
    ConPlan:=false;
    totalplanpago:=0;
    for c:=0 to grillasplanes.ColCount-1 do
     for d:=1 to grillasplanes.RowCount-1 do grillasplanes.Cells[c,d]:='';
    grillasplanes.RowCount:=2;
   end;
   DataSetPlanes.Close;
   DataSetPlanes.Connection:=nil;  }
   if not ESTCUE.IsEmpty then begin
    for t:=1 to ESTCUE.RecordCount do begin
     ESTCUE.RecNo:=t;
     if (trim(ESTCUE.Fields[3].AsString) = '1111801') and (trim(ESTCUE.Fields[12].AsString) = 'PAGADO') then begin
      periodo:=trim(ESTCUE.Fields[6].AsString);
      impcobro:=trim(ESTCUE.Fields[16].AsString);
      feccobro:=trim(ESTCUE.Fields[14].AsString);
      nrorec:=trim(ESTCUE.Fields[15].AsString);
     end;
    end;
    Acum:=0;

    for t:=1 to ESTCUE.RecordCount do begin
     ESTCUE.RecNo:=t;
     if (trim(ESTCUE.Fields[3].AsString) = '1111801') and
      (trim(ESTCUE.Fields[11].AsString) = 'VENCIDO') AND (trim(ESTCUE.Fields[12].AsString) = 'DEUDA')    then
      Acum:=Acum + ESTCUE.Fields[8].AsFloat + ESTCUE.Fields[9].AsFloat;
    end;

    sumaimp:=0;
    sumaint:=0;

    for t:=1 to ESTCUE.RecordCount do begin
     ESTCUE.RecNo:=t;
     if (trim(ESTCUE.Fields[13].AsString) = 'MULTIPLES')  then
      pagmultiples := pagmultiples + 1;
    end;

   end
   else begin
    ESTCUE.Close;
   end;
  end
  else begin
    ACTIV.Close;
  end;
  ESTCUE.Connection :=nil;
 end;
 if nro = 5 then begin
  dataset1.Close;
  dataset1.Connection:=modulo2.ObjConexionComercio;
  dataset1.CommandText:= 'SELECT ''Bº '' + Barrio + '' - Calle:'' + Calle + '' Nº:'' + convert(nvarchar(10),Altura) '
