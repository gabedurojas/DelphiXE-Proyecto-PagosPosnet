 Modulo2.ObjConexionComercio:=TADOConnection.Create(nil);
 Modulo2.ObjConexionComercio.LoginPrompt:=false;
 Modulo2.ObjConexionComercio.ConnectionString:=modulo2.ConecSql;
 if nro = 0 then begin
 { DataSetRubros.Close;
  DataSetRubros.Connection:=modulo2.ObjConexionComercio;
  DataSetRubros.CommandText:='SELECT SubRubro,Detalle FROM VLosRubrosComercios';
  DataSetRubros.Open;
  if not DataSetRubros.IsEmpty then begin
   for t:=1 to DataSetRubros.RecordCount do begin
    DataSetRubros.RecNo:=t;
    grillarubros.RowCount:=t+1;
    grillarubros.Cells[0,t]:=trim(DataSetRubros.Fields[0].AsString);
    grillarubros.Cells[1,t]:=trim(DataSetRubros.Fields[1].AsString);
   end;
  end
  else begin
   DataSetRubros.Close;
  end;
  DataSetRubros.Connection :=nil; }
 end;
 if nro=1 then begin
  COMERCIOS.Close;
  COMERCIOS.Connection:=modulo2.ObjConexionComercio;
  DTS.DataSet:=COMERCIOS;
  Barra1.Panels[0].Text:='Buscando en Base de Datos... por favor espere!!';
   txt:='SELECT IdComercio,TH,FechaInicio,FechaHabilitacion,Denominacion,Cuim,NroDni,Contribuyente,'
   +'Mail,Responsable,CUIT,IdTh,(select IdContribuyente from SeguridadWEB.dbo.ContribuyentesIdentidad where '
   +' CUIM=a.Cuim and activo=1) as Idcont FROM Fn_ComercioDatosDetPorCuit ('+ trim(ODNI.Text) + ') as a';
  COMERCIOS.CommandText:= txt;
  COMERCIOS.Open;
  if not COMERCIOS.IsEmpty then begin
   JvDBGrid1.Columns[0].Width:=60;
   JvDBGrid1.Columns[1].Width:=80;
   JvDBGrid1.Columns[2].Width:=85;
   JvDBGrid1.Columns[3].Width:=85;
