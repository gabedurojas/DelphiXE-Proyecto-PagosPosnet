   JvDBGrid1.Columns[5].Width:=1;
   JvDBGrid1.Columns[6].Width:=1;
   JvDBGrid1.Columns[7].Width:=290;
   JvDBGrid1.Columns[8].Width:=250;
   JvDBGrid1.Columns[9].Width:=20;
   JvDBGrid1.Columns[10].Width:=1;
   JvDBGrid1.Columns[11].Width:=1;
   JvDBGrid1.Columns[12].Width:=1;
   Barra1.Panels[0].Text:='Datos encontrado y en pantalla...';
  end
  else begin
   Barra1.Panels[0].Text:='Ningún dato encontrado!!';
   messagedlg('ERROR!! No existe Comercio que coincida con la busqueda...',mtError,[mbok],0);
   if R1.Checked then ODNI.SetFocus;
   if R2.Checked then ONOMB.SetFocus;
   if R3.Checked then ODNI.SetFocus;
   if R4.Checked then ODNI.SetFocus;
   COMERCIOS.Close;
  end;
  COMERCIOS.Connection :=nil;
 end;
 if nro = 2 then begin
  DOMIC.Close;
  DOMIC.Connection:=modulo2.ObjConexionComercio;
  DTS2.DataSet:=DOMIC;
  DOMIC.CommandText:='SELECT distinct Id,Barrio,Calle,Altura,Manzana,Sector,Parcela,Piso,Local,Dpto,Casa,Torre,Postal'
  + ' FROM Fn_ComerciosDomicilio (' + COMERCIOS.Fields[0].AsString + ',null)';
  DOMIC.Open;
  if not DOMIC.IsEmpty then begin
   coloca1(5);
   for t:=1 to DOMIC.RecordCount do begin
    DOMIC.RecNo:=1;
    elbarrio:=trim(DOMIC.Fields[1].AsString);
    elcalle:=trim(DOMIC.Fields[2].AsString);
    elnro:=trim(DOMIC.Fields[3].AsString);
    elManzana:=trim(DOMIC.Fields[4].AsString);
    elSector:=trim(DOMIC.Fields[5].AsString);
    elParcela:=trim(DOMIC.Fields[6].AsString);
    elPiso:=trim(DOMIC.Fields[7].AsString);
    elLocal:=trim(DOMIC.Fields[8].AsString);
    elDpto:=trim(DOMIC.Fields[9].AsString);
    elCasa:=trim(DOMIC.Fields[10].AsString);
    elTorre:=trim(DOMIC.Fields[11].AsString);
