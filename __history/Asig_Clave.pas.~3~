  if not dataset1.IsEmpty then begin
   domicilio:=dataset1.Fields[0].AsString;
  end
  else begin
   dataset1.Close;
  end;
  dataset1.Connection :=nil;
 end;
 if nro = 9 then begin
  DOMIC.Close;
