{$R *.dfm}

procedure TBuscar_Liquidaciones.FormCreate(Sender: TObject);
begin
gh:=false;
end;

procedure TBuscar_Liquidaciones.FormActivate(Sender: TObject);
begin
 if not(gh) then begin
  gh:=true;
  muni:=false;
  DATOS:=TADODataSet.Create(nil);
  DATOS.ConnectionString:=modulo2.ConecMuni;
  ONOMB.SetFocus;
 end;
end;

procedure TBuscar_Liquidaciones.Coloca1(nro:byte);
var t:integer;
    Txt:widestring;
begin
 if nro=1 then begin
  if nroopcion=1 then begin
    DATOS.Close;
    datasource1.DataSet:=DATOS;
    Txt:='SELECT idregistro, codbar43 as NroLiquidacion,cuim,respopag, partida, supinm,nro_doc,nomraz, '
    +'monto1v, primerv, puntov,idrubro, codigoobjeto, nrocuota,SubRubro FROM tasaanualLiquidacion ';
    if R1.Checked = true then Txt:=Txt + ' where nomraz like ' + chr(39) +  trim(ONOMB.Text) + '%' + chr(39)+ ' ORDER BY nomraz;'; // por apellido
    if R2.Checked = true then Txt:=Txt + ' where monto1v like ' + chr(39) +  trim(ONOMB.Text) + '%' + chr(39)+ ' ORDER BY 1;'; // por apellido
    DATOS.CommandText:=Txt;
    DATOS.Open;
    if DATOS.RecordCount <> 0 then begin
      DBGrid1.Columns[0].Width:=70;
      DBGrid1.Columns[1].Width:=90;
      DBGrid1.Columns[2].Width:=70;
      DBGrid1.Columns[3].Width:=80;
      StatusBar1.Panels[1].Text:= 'Total de Liquidaciones: ' + inttostr(DATOS.RecordCount);
    end
    else begin
      messagedlg('Error!! Este Comercio no Existe en la Base de Datos.',mterror,[mbok],0);
    end;
  end;
 end;
end;

procedure TBuscar_Liquidaciones.Limpiar(nro:byte);
begin
 L1.Caption:='...';L2.Caption:='...';
 L3.Caption:='...';L4.Caption:='...';
 L5.Caption:='...';L7.Caption:='...';
 L8.Caption:='...';L9.Caption:='...';
 DATOS.Close;
 muni:=false;
 if nro = 1 then begin
  R2.Checked:=true;
  ONOMB.Clear;
  ONOMB.SetFocus;
 end;
end;

