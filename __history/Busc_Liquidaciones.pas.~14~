  L3.Caption:=trim(DBGrid1.Fields[7].AsString);  // contrib
  L4.Caption:=trim(DBGrid1.Fields[12].AsString);  // cod objeto
  L5.Caption:=trim(DBGrid1.Fields[6].AsString);  // dni
  L7.Caption:=trim(DBGrid1.Fields[8].AsString);  // importe
  L8.Caption:=trim(DBGrid1.Fields[1].AsString);  // codbar43
  L9.Caption:=trim(DBGrid1.Fields[9].AsString);
  muni:=true;
  SALIR.SetFocus;
end;
end;

