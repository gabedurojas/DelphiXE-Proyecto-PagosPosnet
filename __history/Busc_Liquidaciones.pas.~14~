end;

procedure TBuscar_Liquidaciones.ONOMBKeyPress(Sender: TObject; var Key: Char);
begin
if key = chr(13) then Buscar.SetFocus;
end;

procedure TBuscar_Liquidaciones.ODNIKeyPress(Sender: TObject; var Key: Char);
begin
 if key =#13 then begin
  Buscar.SetFocus;
 end
 else begin
  if R2.Checked then begin
    if ( StrScan('0123456789.',Key) <> nil ) or ( Key = Char(VK_BACK) ) then
    else Key := #0;
  end
  else begin
    //
  end;
 end;
end;

