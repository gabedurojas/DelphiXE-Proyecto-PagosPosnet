if trim(DBGrid1.Fields[0].AsString) <> '' then begin
  //idregistro, codbar43 as NroLiquidacion,cuim,respopag, partida, supinm,'
  //    +' nro_doc,nomraz, monto1v, primerv, puntov,idrubro, codigoobjeto, nrocuota,SubRubro
  L1.Caption:=trim(DBGrid1.Fields[0].AsString);  // id
