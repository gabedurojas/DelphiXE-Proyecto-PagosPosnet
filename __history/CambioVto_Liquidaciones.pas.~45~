Cnx2:=TADOConnection.Create(nil);
if nro = 1 then begin
 try
  PLANES.Close;
  Cnx2.ConnectionString:=Modulo2.ConectDbMuni;
  Cnx2.LoginPrompt:=false;
  DataSource2.DataSet:=PLANES;
  PLANES.Connection:=Cnx2;
  PLANES.CommandText:='SELECT idregistro,cuim,partida,nro_doc,nomraz ,monto1v'
  +',primerv,monto2v,segundv,codbar43,codbarf,puntov,fechahora,idrubro,codigoobjeto'
  +',SubRubro from tasaanualliquidadion where (codbar43 = ' + trim(nrodeplan.Text) + ')';
