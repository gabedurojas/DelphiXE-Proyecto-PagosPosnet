procedure TCambioVToLiqui.LdKeyPress(Sender: TObject; var Key: Char);
begin
 if key = #13 then begin
  Key := #0;
  INSERTAR.SetFocus;
 end;
end;

procedure TCambioVToLiqui.nrodeplanExit(Sender: TObject);
begin
 if (trim(nrodeplan.Text) = '0') then begin
  messagedlg('Error!! No Existe un Nro de Liquidacion ingresado.',mterror,[mbok],0);
  nrodeplan.SetFocus;
 end;
end;

procedure TCambioVToLiqui.nrodeplanKeyPress(Sender: TObject; var Key: Char);
begin
 if key = #13 then begin
  Key := #0;
  JvBitBtn1.SetFocus;
 end
 else begin
  if (StrScan('0123456789',Key) <> nil) or (Key = Char(VK_BACK)) then
   else Key := #0;
 end;
end;

