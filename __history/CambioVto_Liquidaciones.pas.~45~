procedure TCambioVToLiqui.JvBitBtn1Click(Sender: TObject);
begin
 if (trim(nrodeplan.Text) = '') then begin
  messagedlg('ATENCION!! No Existe un Nro de Liquidacion ingresado.',mtwarning,[mbok],0);
  nrodeplan.SetFocus;
 end
 else Coloca1(1);
