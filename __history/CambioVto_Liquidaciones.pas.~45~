procedure TCambioVToLiqui.INSERTARClick(Sender: TObject);
var gf,a:integer;
    Com1:TADOCommand;
    Cnx2:TADOConnection;
begin
  gf:=messagedlg('Confirma Modificar el Vencimiento de esta Liquidacion seleccionada?',mtWarning,[mbok,mbCancel],0);
  if gf = 1 then begin
   try
    Cnx2:=TADOConnection.Create(nil);
    Cnx2.LoginPrompt:=false;
    Cnx2.ConnectionString:=modulo2.ConectDbMuni;

    Com1:=TADOCommand.Create(nil);
    Com1.Connection:=Cnx2;

    Com1.CommandText:='UPDATE [municipio].[dbo].[tasaanualLiquidacion] SET '
    +'primerv = ' + chr(39) + trim(DateToStr(ld.Date)) + chr(39)
    +',segundv = '  + chr(39) + trim(DateToStr(ld.Date)) + chr(39)
    + ' WHERE (idregistro = ' + dato + ')';
    Com1.Execute;

    messagedlg('EXITO!! Liquidacion Modificada correctamente',mtconfirmation,[mbok],0);

   except
    EnviarLog(self.Caption,Com1.CommandText);
    messagedlg('Error!! Esta liquidacion NO pudo ser Modificada.',mterror,[mbok],0);
   end;
   FreeAndNil(Com1);
   Cnx2.Close;
   FreeAndNil(Cnx2);
  end;
end;

