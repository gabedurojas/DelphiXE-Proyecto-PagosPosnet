  if not PLANES.IsEmpty then begin
   Barra1.Panels[1].Text:='Cant. Registros: ' + IntToStr(PLANES.RecordCount);
  end
  else begin
   messagedlg('Atencion no existen resultados de la busqueda, por favor ingrese otro valor',mtWarning,[mbok],0);
   nrodeplan.SetFocus;
  end;
  PLANES.Connection:=nil;
 except
  on E: Exception do begin
    EnviarLog(Self.Caption, E.Message);
    EnviarLog(Self.Caption, comando);
  end;
 end;
end;
if nro = 3 then begin
 {try
  Cnx2.ConnectionString:=Modulo2.ConectDbMuni;
  Cnx2.LoginPrompt:=false;
  ESTCUENTA.Close;
  DataSource1.DataSet:=ESTCUENTA;
  ESTCUENTA.Connection:=Cnx2;
  if CheckBox1.Checked then begin
   ESTCUENTA.CommandText:='SELECT NroPlan, case when NroCuota = 0 then ''Anticipo'' else convert(nvarchar(10),NroCuota) end as NroCuota,'
   + 'FechaVencimiento,ImporteCuota, 0 as Punitorios,ImporteCuota as TotalCuota,Estado,Origen,NroRecibo,Importe,FechaPago,TipoEstado,PuntoV,Idrubro,'
   + 'detallerubro FROM dbo.EstadoCuentaPlanPago (' + chr(39) + FechaAct + chr(39) + ' , ' + ElNumPlan + ') where (estado <> ''ERROR'')';
  end
  else begin
   ESTCUENTA.CommandText:='SELECT NroPlan, case when NroCuota = 0 then ''Anticipo'' else convert(nvarchar(10),NroCuota) end as NroCuota,'
   + 'FechaVencimiento,ImporteCuota,Punitorios,TotalCuota,Estado,Origen,NroRecibo,Importe,FechaPago,TipoEstado,PuntoV,Idrubro,'
   + 'detallerubro FROM dbo.EstadoCuentaPlanPago (' + chr(39) + FechaAct + chr(39) + ' , ' + ElNumPlan + ') where (estado <> ''ERROR'')';
  end;
  ESTCUENTA.Open;
      //cargo la grilla de las cuotas de los planes CON anticipos
  ESTCUENTA.Connection:=nil;
  except
   on E: Exception do begin
     EnviarLog(Self.Caption, E.Message);
     EnviarLog(Self.Caption, comando);
   end;
 end;
 tot1:=0;
 tot2:=0;
 try
  DataSource1.dataset.disablecontrols;
