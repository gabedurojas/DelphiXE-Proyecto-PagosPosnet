function TModulo2.obtenerNombrePC():Ansistring;
var
  nombre: AnsiString;
  DatosSocket: WSAData;
begin
  WSAStartup($0101, DatosSocket);
  SetLength(nombre, MAX_PATH);
  gethostname(PAnsiChar(Nombre), MAX_PATH);
  SetLength(nombre, StrLen(PAnsiChar(nombre)));
  result := nombre;
end;

function TModulo2.getIPs: Tstrings;
type
  TaPInAddr = array[0..10] of PInAddr;
  PaPInAddr = ^TaPInAddr;
var
  phe: PHostEnt;
  pptr: PaPInAddr;
  Buffer: array[0..63] of AnsiChar;
  I: Integer;
  GInitData: TWSAData;
begin
  WSAStartup($101, GInitData);
  Result := TstringList.Create;
  Result.Clear;
  GetHostName(Buffer, SizeOf(Buffer));
  phe := GetHostByName(buffer);
  if phe = nil then Exit;
  pPtr := PaPInAddr(phe^.h_addr_list);
  I    := 0;
  while pPtr^[I] <> nil do
  begin
    Result.Add(inet_ntoa(pptr^[I]^));
    Inc(I);
  end;
  WSACleanup;
end;

function Tmodulo2.ConectionString(NombreArchIni,NombreAplicacion:string;NroConexion,Parte:byte;
                            BorrarArchivo,ActivaLog:boolean):string;
var Arch,NomApl,Res:PAnsiChar;
    //NrCx,Prt:UCHAR;
    rt:string;
begin
Arch:=PAnsiChar(NombreArchIni);
NomApl:=PAnsiChar(NombreAplicacion);
DLLHandle := LoadLibrary(NombreDll);
Res:=PAnsiChar('');
if (DLLHandle > 0) then begin
  try
    @DLLConectionString := GetProcAddress(DLLHandle, 'ConectionString');
     {if procedure is found in the dll}
    if Assigned(DLLConectionString) then begin
       Res:=DLLConectionString(Arch,NomApl,NroConexion,Parte,BorrarArchivo,ActivaLog);
       rt:=string(Res);
    end
    else begin
       rt:=string(Res);
       ShowMessage('No se existe Función: ConectionString');
    end;
   finally
     {unload a library}
     FreeLibrary(DLLHandle);
   end;
end
else ShowMessage('No se encuentra Libreria ' + NombreDll);
Result:=rt;
end;

