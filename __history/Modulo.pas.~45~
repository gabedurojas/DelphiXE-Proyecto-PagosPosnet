Function Tmodulo2.TamanioArchivoFTP(NombreArchivo,DirectoriosInternos:string):integer;
var t:integer;
    DirInt:string;
begin
{ try
  FTP.Connect;
  for t:=1 to cuenta(DirectoriosInternos,'/') + 1 do begin
    DirInt:=extrae(DirectoriosInternos,'/',t);
    FTP.ChangeDir(DirInt);
  end;
  Result:=FTP.Size(NombreArchivo);
 except
  Result:=0;
 end;
 FTP.Disconnect;   }
end;

Function Tmodulo2.BorrarArchivoFTP(NombreArchivo,DirectoriosInternos:string):boolean;
var t:integer;
    DirInt:string;
begin
{ try
  FTP.Connect;
  for t:=1 to cuenta(DirectoriosInternos,'/') + 1 do begin
    DirInt:=extrae(DirectoriosInternos,'/',t);
    FTP.ChangeDir(DirInt);
  end;
  if ExisteDir(NombreArchivo,false) then FTP.Delete(NombreArchivo);
  Result:=true;
 except
  Result:=false;
  raise Exception.Create( 'No se ha podido conectar con el servidor ' + FTP.Host );
 end;
 FTP.Disconnect;    }
end;


procedure TModulo2.CargaCombo(var Combo:TComboBox;  comando,ConectDB:Widestring);
var k,z:integer;
    DataSet1:TADODataSet;
    MiObjeto:TComboClase;
begin
Combo.Clear;
DataSet1:=TADODataSet.Create(nil);
DataSet1.ConnectionString:=ConectDB;
DataSet1.CommandText:=Comando;
DataSet1.Open;
for k:=1 to DataSet1.RecordCount do begin
  DataSet1.RecNo:=k;
  MiObjeto:=TComboClase.Create;
  for z:=1 to DataSet1.FieldCount-1 do begin
    if z = 1 then MiObjeto.Identificador:=trim(DataSet1.Fields[1].AsString);
    if z = 2 then MiObjeto.Param2:=trim(DataSet1.Fields[2].AsString);
    if z = 3 then MiObjeto.Param3:=trim(DataSet1.Fields[3].AsString);
    if z = 4 then MiObjeto.Param4:=trim(DataSet1.Fields[4].AsString);
  end;
  Combo.Items.AddObject(trim(DataSet1.Fields[0].AsString),MiObjeto);
end;
DataSet1.Close;
DataSet1.Connection:=nil;
DataSet1.Free;
Combo.ItemIndex:=0;
end;

procedure TModulo2.LiberarCombo(var Combo:TComboBox);
var q:integer;
begin
For q:= Combo.items.count-1 downto 0 do
   TComboClase(Combo.items.objects[q]).Free;
end;

end.
