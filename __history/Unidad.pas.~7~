begin

if length(fecha)<10 then begin
 if length(fecha) = 7 then begin
   dia:=('0' + fecha[1]);
   mes:=(fecha[3] + fecha[4]);
   ano:=('20' + fecha[6] + fecha[7]);
   fechalarga:=dia + '/' + mes + '/' + ano;
 end
 else begin
   dia:=(fecha[1] + fecha[2]);
   mes:=(fecha[4] + fecha[5]);
   ano:=('20' + fecha[7] + fecha[8]);
   fechalarga:=dia + '/' + mes + '/' + ano;
 end;
end
else begin
 fechalarga:=fecha;
end;

end;

