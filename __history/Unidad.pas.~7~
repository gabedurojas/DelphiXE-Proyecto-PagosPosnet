   la_ret:= '0' + la_ret;
   v_largo:= length(la_ret);
end;
{Convierto los pares a caracteres}
LcCar:='';ro:=1;
while ro <= v_largo do begin
  v_num:=strtoint(MidStr(la_ret,ro,2)) + 32;
  LcCar:=LcCar + chr(v_num);
  ro:=ro+2;
end;
