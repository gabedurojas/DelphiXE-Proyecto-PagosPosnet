procedure TModulo2.DataModuleCreate(Sender: TObject);
var BaseDatos,Server,Psw,Usr,Tmp,conec2,conec3:string;
//VAR conec2,conec3:WIDESTRING;
begin
path_todo:=GetCurrentDir();
PathIni:=path_todo + '\sistemas.ini';
NroAplicacion:='1';
PuntoV:='20';
UsuNvl:='';
if FileExists(PathIni) then begin
  MyIP:=getIPs.Strings[0];
  usuario:=obtenerUsuarioRed;
  MyHost:=obtenerNombrePC;

  SetLength(RFtpDatos,3);
  SetLength(WFtpDatos,3);
  try
    RFtpDatos[0]:=ReadIni(PathIni,'FTP','FTPHost','127.0.0.1');
    Psw:=ReadIni(PathIni,'FTP','FTPK1','');
    Usr:=ReadIni(PathIni,'FTP','FTPUsuario1','');
    RFtpDatos[1]:=DencryptStr(Usr,Psw,'T');
    Usr:=ReadIni(PathIni,'FTP','FTPP1','');
    RFtpDatos[2]:=DencryptStr(Usr,Psw,'T');

    WFtpDatos[0]:=ReadIni(PathIni,'FTP','FTPHost','127.0.0.1');
    Psw:=ReadIni(PathIni,'FTP','FTPK2','');
    Usr:=ReadIni(PathIni,'FTP','FTPUsuario2','');
    WFtpDatos[1]:=DencryptStr(Usr,Psw,'T');
    Usr:=ReadIni(PathIni,'FTP','FTPP2','');
    WFtpDatos[2]:=DencryptStr(Usr,Psw,'T');

    Server:=ReadIni(PathIni,'BaseDeDatos','NombreServer','');
    BaseDatos:='ComercioTasa';

    if Server = '192.168.0.105' then begin
//      Usr:=ConectionString('Resource','TasaComercio',1,3,false,false);
//      Psw:=ConectionString('Resource','TasaComercio',1,4,true,false);
//      Conec2:=ConectionString('Resource','ConInmo',1,3,false,false);
//      Conec3:=ConectionString('Resource','ConInmo',1,4,true,false);
      Usr:=ReadIni(PathIni,'SQL','Ini8','');
      Tmp:=ReadIni(PathIni,'SQL','Default8','');
      Usr:=DencryptStr(Usr,Tmp,'T');
      Psw:=ReadIni(PathIni,'SQL','Cl8','');
      Tmp:=ReadIni(PathIni,'SQL','Default8','');
      Psw:=DencryptStr(Psw,Tmp,'T');
      Conec2:=ConectionString('Resource','ConInmo',1,3,false,false);
      Conec3:=ConectionString('Resource','ConInmo',1,4,true,false);
    end
    else begin
      Usr:=ConectionString('Resource','TasaComercio',1,3,false,false);
      Psw:=ConectionString('Resource','TasaComercio',1,4,true,false);
      Conec2:=ConectionString('Resource','ConInmo',1,3,false,false);
      Conec3:=ConectionString('Resource','ConInmo',1,4,true,false);
    end;
   
    ConecSql:='Provider=SQLOLEDB.1;Password=' + chr(39) + Psw + chr(39)
           + ';Persist Security Info=True;User ID=' + Usr
           + ';Initial Catalog=' + BaseDatos + ';Data Source=' + server
           + ';Use Procedure for Prepare=1;Auto Translate=True;Packet Size=4096;'
           + 'Use Encryption for Data=False;Tag with column collation when possible=False;';
    ConecMuni:='Provider=SQLOLEDB.1;Password=' + chr(39) + Conec3 + chr(39)
           + ';Persist Security Info=True;User ID=' + Conec2
           + ';Initial Catalog=municipio;Data Source=' + server
           + ';Use Procedure for Prepare=1;Auto Translate=True;Packet Size=4096;'
           + 'Use Encryption for Data=False;Tag with column collation when possible=False;';
    ConecSegWeb:='Provider=SQLOLEDB.1;Password=' + chr(39) + Conec3 + chr(39)
           + ';Persist Security Info=True;User ID=' + Conec2
           + ';Initial Catalog=SeguridadWeb;Data Source=' + server
           + ';Use Procedure for Prepare=1;Auto Translate=True;Packet Size=4096;'
           + 'Use Encryption for Data=False;Tag with column collation when ' +
           'possible=False;';

  CerrarApl:=false;
  DataSetGral:=TADODataSet.Create(nil);
  DataSetGral.ConnectionString:=ConecSql;
  DataSetGral.CommandText:='SELECT Version,EsCritica FROM VersionSoft WHERE (Activo=1)';
  DataSetGral.Open;
  if not DataSetGral.IsEmpty then begin
   if trim(DataSetGral.Fields[0].AsString) = VersionSoft then CerrarApl:=false
   else begin
    if DataSetGral.Fields[1].AsBoolean then begin
      messagedlg('ATENCION!! Existe una versión NUEVA y deba actualizarla...' + chr(13)
      + 'La actualización se considera CRITICA; por lo tanto se cerrará el SISTEMA',mterror,[mbok],0);
      CerrarApl:=true;
    end
    else begin
      messagedlg('ATENCION!! Existe una versión NUEVA se recomienda actualizarla...',mtWarning,[mbok],0);
      CerrarApl:=false;
    end;
   end;
  end
  else begin
    messagedlg('ERROR!! No es posible determinar la versión vigente, por lo tanto se cerrará el SISTEMA',mterror,[mbok],0);
    CerrarApl:=true;
  end;
  DataSetGral.Close;
  DataSetGral.Free;
  DataSetGral:=nil;

  except
    messagedlg('Error al Intento de Conección a la Base de Datos de SQL Server',mterror,[mbok],0);
    CerrarApl:=true;
  end;
end
else messagedlg('No exite la Conección a Base de Datos de SQL Server',mterror,[mbok],0);
end;

