Function TModulo2.ReadIni(ArchivoIni,Etiqueta,Variable,ValoXDefecto:string):string;
var Arch,Etiq,Vari,Valor,Res:PAnsiChar;
    rt:string;
begin
Arch:=PAnsiChar(AnsiString(ArchivoIni));
Etiq:=PAnsiChar(AnsiString(Etiqueta));
Vari:=PAnsiChar(AnsiString(Variable));
Valor:=PAnsiChar(AnsiString(ValoXDefecto));
Res:=PAnsiChar(AnsiString(''));
DLLHandle := LoadLibrary(NombreDll);
if (DLLHandle > 0) then begin
  try
    @DLLReadIni := GetProcAddress(DLLHandle, 'ReadIni');
     {if procedure is found in the dll}
    if Assigned(DLLReadIni) then begin
       Res:=DLLReadIni(Arch,Etiq,Vari,Valor);
       rt:=string(Res);
    end
    else begin
       rt:=string(Res);
       ShowMessage('No se existe Función: ReadIni');
    end;
   finally
     {unload a library}
     FreeLibrary(DLLHandle);
   end;
end
else ShowMessage('No se encuentra Libreria ' + NombreDll);
Result:=rt;
end;

